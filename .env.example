# Copy this file to .env and fill in credentials from your own cloud account.
# Never commit the resulting .env file.

# Azure Speech TTS
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure OpenAI image generation
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=

# Optional: reduce this to 1 when the image service rate-limits requests.
IMAGE_GENERATION_CONCURRENCY=2
