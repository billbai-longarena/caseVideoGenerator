{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:case-video:case-inputs:v1",
  "title": "Normalized case inputs",
  "type": "object",
  "required": ["version", "project_name", "source_refs", "production"],
  "properties": {
    "version": {"const": "1"},
    "project_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "production": {
      "type": "object",
      "required": ["column", "approval_mode"],
      "properties": {
        "column": {"type": "string", "minLength": 1},
        "target_duration": {"type": ["string", "null"]},
        "approval_mode": {"enum": ["editorial", "auto", "full"]}
      },
      "additionalProperties": false
    },
    "structured_fields": {"type": "object"}
  },
  "additionalProperties": false
}
