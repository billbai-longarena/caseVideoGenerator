{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:case-video:case-model:v1",
  "title": "Case model",
  "type": "object",
  "required": ["version", "actors", "situation", "conflict", "turning_points", "outcome", "lessons", "source_refs"],
  "properties": {
    "version": {"const": "1"},
    "actors": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "role"], "properties": {"name": {"type": "string"}, "role": {"type": "string"}}, "additionalProperties": false}},
    "situation": {"type": "string", "minLength": 1},
    "conflict": {"type": "string", "minLength": 1},
    "turning_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outcome": {"type": "string", "minLength": 1},
    "lessons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "numbers": {"type": "array", "items": {"type": "object"}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
