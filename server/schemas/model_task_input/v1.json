{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:case-video:model-task-input:v1",
  "title": "Model task input envelope",
  "type": "object",
  "required": ["task", "context"],
  "properties": {
    "task": {"type": "string", "minLength": 1},
    "context": {"type": "object"},
    "source_excerpts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["source_id", "text"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": ["string", "null"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "additionalProperties": false
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["media_id", "mime_type", "data_base64"],
        "properties": {
          "media_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "mime_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
          "data_base64": {"type": "string", "minLength": 4, "maxLength": 8000000},
          "description": {"type": "string", "maxLength": 2000}
        },
        "additionalProperties": false
      }
    },
    "issues": {"type": "array", "items": {"type": "object"}},
    "constraints": {"type": "object"}
  },
  "additionalProperties": false
}
