{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:case-video:visual-plan:v1",
  "title": "Unit anchored Remotion visual plan",
  "type": "object",
  "required": ["version", "cover", "subtitleLabel", "scenes"],
  "properties": {
    "version": {"const": "1"},
    "cover": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1}, "proof": {"type": "string"}}, "additionalProperties": false},
    "brand": {"type": "string"},
    "subtitleLabel": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "atUnit", "units", "layout", "headline", "visual_intent"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "atUnit": {"type": "integer", "minimum": 0},
          "units": {"type": "integer", "minimum": 1},
          "layout": {"enum": ["cover", "hero", "split", "quote", "comparison", "timeline", "evidence", "summary"]},
          "headline": {"type": "string", "minLength": 1},
          "kicker": {"type": "string"},
          "visual_intent": {"type": "string", "minLength": 1},
          "keywords": {"type": "array", "items": {"type": "string"}},
          "reuse": {"type": "boolean", "default": false},
          "allowBackgroundReuse": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
