{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:case-video:source-manifest:v1",
  "title": "Source manifest",
  "type": "object",
  "required": ["version", "files"],
  "properties": {
    "version": {"const": "1"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id", "upload_id", "original_name", "safe_name", "media_type",
          "size_bytes", "sha256", "extraction_status", "external_sharing_policy", "warnings"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "upload_id": {"type": ["string", "null"]},
          "original_name": {"type": "string", "minLength": 1},
          "safe_name": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "extraction_status": {"enum": ["pending", "succeeded", "failed", "ocr_required"]},
          "extracted_text_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "external_sharing_policy": {"enum": ["summary_only", "structured_excerpt", "prohibited"]},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "error_code": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
