{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:case-video:frame-review:v1",
  "title": "Rendered intent frame review",
  "type": "object",
  "required": ["version", "verdict", "summary", "scene_reviews", "issues"],
  "properties": {
    "version": {"const": "1"},
    "verdict": {"enum": ["pass", "revise", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 3000},
    "scene_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "frame_ids",
          "intent_alignment",
          "hierarchy",
          "legibility",
          "density",
          "assessment"
        ],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "frame_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "intent_alignment": {"type": "integer", "minimum": 1, "maximum": 5},
          "hierarchy": {"type": "integer", "minimum": 1, "maximum": 5},
          "legibility": {"type": "integer", "minimum": 1, "maximum": 5},
          "density": {"type": "integer", "minimum": 1, "maximum": 5},
          "assessment": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "scene_id",
          "category",
          "observation",
          "repair_instruction"
        ],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocker", "major", "minor"]},
          "scene_id": {"type": "string", "minLength": 1},
          "beat_id": {"type": "string", "minLength": 1},
          "frame_id": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "intent",
              "hierarchy",
              "legibility",
              "density",
              "continuity",
              "template_leak",
              "chrome",
              "asset_fit",
              "other"
            ]
          },
          "observation": {"type": "string", "minLength": 1, "maxLength": 2000},
          "repair_instruction": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
