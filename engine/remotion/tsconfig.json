{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "es2021"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2021"
  },
  "include": ["src"]
}
